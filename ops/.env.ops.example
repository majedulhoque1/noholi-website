# Copy to ops/.env.ops (gitignored) and fill in. Used by ops/scripts/predeploy-dump.sh
# and ops/scripts/restore-local.sh. Same values as the noholi-backups repo secrets.
# NEVER commit ops/.env.ops. It holds the prod DB password.

# Supabase -> Connect -> Session pooler (port 5432). URL-encode special chars in the password.
SUPABASE_DB_POOLER_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<n>-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# age PUBLIC key (age1...). Encrypts only; safe to keep here.
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 (S3 API). Token scoped to the one bucket, Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=noholi-backups

# Restore only: path to the age PRIVATE key file. Keep it outside the repo.
# AGE_KEY_FILE=/path/outside/repo/noholi-backup-key.txt

# Optional: a pg_dump/pg_restore >= 17 on this machine. Without one, the scripts use Docker.
# PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
